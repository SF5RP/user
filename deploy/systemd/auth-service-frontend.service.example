# Installation:
#   sudo cp auth-service-frontend.service.example /etc/systemd/system/auth-service-frontend.service
#   # adjust node path if needed: which node
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now auth-service-frontend
#
# Sudoers example for deploy user:
#   deploy ALL=(ALL) NOPASSWD:/bin/systemctl restart auth-service-frontend

[Unit]
Description=Auth Service Next.js frontend (standalone)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/auth-service/current/frontend
EnvironmentFile=/srv/auth-service/shared/frontend/env/frontend.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
